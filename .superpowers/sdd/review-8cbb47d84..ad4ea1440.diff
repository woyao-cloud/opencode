niopencode.jsonc", ".miniopencode.json"] +  for (const name of candidates) { +    const p = path.join(dir, name) +    if (fs.existsSync(p)) return p +  } +  const parent = path.dirname(dir) +  if (parent !== dir) return findConfigFile(parent) +  return undefined +} + +function loadConfigFile(filePath: string): MiniOpenCodeConfig { +  const raw = fs.readFileSync(filePath, "utf-8") +  const parsed = JSON.parse(raw) +  const decoded = Schema.decodeUnknownSync(MiniOpenCodeConfig as any)(parsed) +  log.info("config loaded", { path: filePath }) +  return decoded +} + +export const ConfigLive = Layer.effect( +  ConfigService, +  Effect.gen(function* () { +    const ref = yield* InstanceRef +    const configPath = findConfigFile(ref.directory) +    const config: MiniOpenCodeConfig = configPath +      ? loadConfigFile(configPath) +      : defaultConfig +    return { config, configPath } +  }), +) diff --git a/miniopencode/packages/opencode/src/config/index.ts b/miniopencode/packages/opencode/src/config/index.ts new file mode 100644 index 000000000..56fa8f16f --- /dev/null +++ b/miniopencode/packages/opencode/src/config/index.ts @@ -0,0 +1,3 @@ +export * as Config from "./config" +export * as ConfigAgent from "./agent" +export * as ConfigProvider from "./provider" diff --git a/miniopencode/packages/opencode/src/config/provider.ts b/miniopencode/packages/opencode/src/config/provider.ts new file mode 100644 index 000000000..34f699445 --- /dev/null +++ b/miniopencode/packages/opencode/src/config/provider.ts @@ -0,0 +1,10 @@ +import { Schema } from "effect" + +export const ProviderConfigSchema = Schema.Struct({ +  providers: Schema.optional(Schema.Record(Schema.String, Schema.Struct({ +    apiKey: Schema.optional(Schema.String), +    baseURL: Schema.optional(Schema.String), +    model: Schema.optional(Schema.String), +  }))), +}) +export type ProviderConfigSchema = Schema.Schema.Type<typeof ProviderConfigSchema> diff --git a/miniopencode/packages/opencode/src/file/index.ts b/mini