th = { +  get home() { return xdgBasedir() ?? path.join(process.env.HOME || process.env.USERPROFILE || "/tmp", ".miniopencode") }, +  get share() { return path.join(this.home, "share") }, +  get state() { return path.join(this.home, "state") }, +  get tmp() { return path.join(this.home, "tmp") }, +  get db() { return path.join(this.home, "state", "miniopencode.db") }, +  get log() { return path.join(this.home, "log") }, +} + +export * as Global from "./global" diff --git a/miniopencode/packages/core/src/installation/version.ts b/miniopencode/packages/core/src/installation/version.ts new file mode 100644 index 000000000..cbe89f193 --- /dev/null +++ b/miniopencode/packages/core/src/installation/version.ts @@ -0,0 +1,2 @@ +export const InstallationVersion = "0.0.1" +export * as Version from "./version" diff --git a/miniopencode/packages/core/src/schema.ts b/miniopencode/packages/core/src/schema.ts new file mode 100644 index 000000000..565c2f730 --- /dev/null +++ b/miniopencode/packages/core/src/schema.ts @@ -0,0 +1,3 @@ +export const NonNegativeInt = Number + +export * as Schema from "./schema" diff --git a/miniopencode/packages/core/src/util/error.ts b/miniopencode/packages/core/src/util/error.ts new file mode 100644 index 000000000..9057ecd34 --- /dev/null +++ b/miniopencode/packages/core/src/util/error.ts @@ -0,0 +1,5 @@ +export class NamedError extends Error { +  constructor(message: string) { super(message); this.name = this.constructor.name } +} + +export * as Error from "./error" diff --git a/miniopencode/packages/core/src/util/log.ts b/miniopencode/packages/core/src/util/log.ts new file mode 100644 index 000000000..f4377fb10 --- /dev/null +++ b/miniopencode/packages/core/src/util/log.ts @@ -0,0 +1,45 @@ +import { mkdirSync, appendFileSync } from "fs" +import path from "path" +import { Path } from "../global" + +export type Level = "DEBUG" | "INFO" | "WARN" | "ERROR" + +let _print = false +let _level: Level = "INFO" +let _logFile: string | undefined + +export async function init(opts: { print?: boolean; level?: Level }) { +  _print = opts.print ?? false +  _level = opts.level ?? "INFO" +  mkdirSync(Path.log, { recursive: true }) +  _logFile = path.join(Path.log, `miniopencode-${new Date().toISOString().slice(0, 10)}.log`) +} + +export function file(): string | undefined { return _logFile } + +function shouldLog(level: Level): boolean { +  const levels: Level[] = ["DEBUG", "INFO", "WARN", "ERROR"] +  return levels.indexOf(level) >= levels.indexOf(_level) +} + +function write(level: Level, service: string, msg: string, data?: Record<string, unknown>) { +  if (!shouldLog(level)) return +  const time = new Date().toISOString() +  const line = `${time} [${level}] [${service}] ${msg}${data ? " " + JSON.stringify(data) : ""}` +  if (_print) process.stderr.write(line + "\n") +  if (_logFile) appendFileSync(_logFile, line + "\n") +} + +export function create(opts: { service: string }) { +  const service = opts.service +  return { +    debug: (msg: string, data?: Record<string, unknown>) => write("DEBUG", service, msg, data), +    info: (msg: string, data?: Record<string, unknown>) => write("INFO", service, msg, data), +    warn: (msg: string, data?: Record<string, unknown>) => write("WARN", service, msg, data), +    error: (msg: string, data?: Record<string, unknown>) => write("ERROR", service, msg, data), +  } +} + +export const Default = create({ service: "miniopencode" }) + +export * as Log from "./log" diff --git a/miniopencode/packages/core/src/util/slug.ts b/miniopencode/packages/core/src/util/slug.ts new file mode 100644 index 000000000..5d8126c74 --- /dev/null +++ b/miniopencode/packages/core/src/util/slug.ts @@ -0,0 +1,8 @@ +export function create(length: number = 12): string { +  const chars = "abcdefghijklmnopqrstuvwxyz0123456789" +  let result = "" +  for (let i = 0; i < length; i++) result += chars[Math.floor(Math.random() * chars.length)] +  return result +} + +export * as Slug from "./slug" diff --git a/miniopencode/